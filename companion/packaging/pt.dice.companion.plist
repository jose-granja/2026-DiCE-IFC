<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the companion at login.

  RunAtLoad with KeepAlive so it survives a crash, and no StandardOutPath: this
  process handles digests, and a log file is a way to write them to disk
  without meaning to.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>pt.dice.companion</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/dice-companion</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
