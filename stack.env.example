NODE_ENV=production
NEXT_PUBLIC_DEBUG=false
# The basemap. `/planet` is a TileJSON source, not a style — MapLibre needs a
# style document, which is what `/styles/…` returns (liberty, bright, positron).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Required, and not merely bookkeeping: this origin is what the CSP allows the
# app to reach for tiles, glyphs and the sprite. A style URL without it is
# blocked and the map silently does not load. Setting it is a privacy decision —
# see docs/adr/003-map-tile-provider.md and the /privacy page.
NEXT_PUBLIC_TILE_ORIGIN=https://tiles.openfreemap.org
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_CESIUM_ION_ASSET_ID=2275207

# Who runs this deployment. Shown on the About and Privacy pages; set before the
# app is offered to the public. NEXT_PUBLIC_OPERATOR_CONTACT is an email address
# or a URL. NEXT_PUBLIC_SOURCE_URL links the licence and source; left empty, it is
# https://github.com/jose-granja/2026-DiCE-IFC.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_CONTACT=
NEXT_PUBLIC_SOURCE_URL=

# Time-stamps for signatures (XAdES-B-T), ADR 012. Server-side only — none of
# these is NEXT_PUBLIC_ and none reaches a browser. Leave TSA_URL empty and the
# signing page says no time-stamp is available; signatures are then B-B.
# Choose a *qualified* time-stamping service from the EU trusted list; ADR 012
# lists options and what was found about their prices. For trying it out, a
# public non-qualified TSA such as https://freetsa.org/tsr works, but its stamps
# are not qualified.
# TSA_URL=
# TSA_USERNAME=
# TSA_PASSWORD=
# Shown to the person signing, e.g. "Example Qualified TSA".
# TSA_NAME=
# Stamps one client may take per hour; each one may cost money.
# TSA_RATE_LIMIT_PER_HOUR=60
