/**
 * Regenerate `lib/bcf/schema/generated.ts` from the vendored `.xsd` files.
 *
 *   npx tsx scripts/bundle-bcf-schema.mts
 *
 * The BCF 3.0 schemas are vendored verbatim from
 * buildingSMART/BCF-XML @ release_3_0 — unlike the IDS ones they needed no
 * edits, because every `xs:include` already points at a sibling file rather
 * than at a URL. The check below keeps it that way: libxml2 resolves those
 * locations literally, so an absolute URL would mean a network fetch at
 * validation time, which the CSP blocks and the privacy line forbids.
 */

import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";

const DIRECTORY = path.resolve(import.meta.dirname, "../lib/bcf/schema");

const FILES: Array<{ file: string; constant: string }> = [
  { file: "markup.xsd", constant: "MARKUP_XSD" },
  { file: "visinfo.xsd", constant: "VISINFO_XSD" },
  { file: "version.xsd", constant: "VERSION_XSD" },
  { file: "project.xsd", constant: "PROJECT_XSD" },
  { file: "extensions.xsd", constant: "EXTENSIONS_XSD" },
  { file: "documents.xsd", constant: "DOCUMENTS_XSD" },
  { file: "shared-types.xsd", constant: "SHARED_TYPES_XSD" },
];

const HEADER = `/**
 * The BCF 3.0 XSDs, inlined.
 *
 * GENERATED by scripts/bundle-bcf-schema.mts — do not edit. Re-run it after
 * updating the vendored .xsd files.
 *
 * Vendored verbatim from buildingSMART/BCF-XML @ release_3_0. Inlined rather
 * than fetched, for the same reason as the IDS schemas: validation must work
 * with no network at all. They sit behind a dynamic import, so they are only
 * downloaded when someone actually validates.
 *
 * \`markup.xsd\`, \`visinfo.xsd\`, \`project.xsd\`, \`extensions.xsd\` and
 * \`documents.xsd\` each \`xs:include\` \`shared-types.xsd\`, so it must be
 * preloaded under exactly that file name alongside whichever one is in use.
 */

`;

const parts = [HEADER];

for (const { file, constant } of FILES) {
  const contents = await readFile(path.join(DIRECTORY, file), "utf8");

  if (contents.includes('schemaLocation="http')) {
    throw new Error(
      `${file} includes a schema by URL. Point it at the vendored sibling, or ` +
        `validation will try to reach the network and fail under the CSP.`,
    );
  }

  parts.push(`export const ${constant} = ${JSON.stringify(contents)};\n\n`);
}

await writeFile(path.join(DIRECTORY, "generated.ts"), parts.join(""));
console.log(`Wrote ${path.join(DIRECTORY, "generated.ts")}`);
