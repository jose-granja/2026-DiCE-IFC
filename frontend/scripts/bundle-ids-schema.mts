/**
 * Regenerate `lib/ids/schema/generated.ts` from the vendored `.xsd` files.
 *
 *   npx tsx scripts/bundle-ids-schema.mts
 *
 * Run this after updating a schema. The vendored `ids.xsd` differs from the
 * published one only in its `xs:import/@schemaLocation` values, which point at
 * the sibling files instead of w3.org URLs — libxml2 resolves those literally,
 * so absolute URLs would mean a network fetch at validation time.
 */

import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";

const DIRECTORY = path.resolve(import.meta.dirname, "../lib/ids/schema");

const FILES: Array<{ file: string; constant: string }> = [
  { file: "ids.xsd", constant: "IDS_XSD" },
  { file: "xml.xsd", constant: "XML_XSD" },
  { file: "XMLSchema.xsd", constant: "XML_SCHEMA_XSD" },
];

const HEADER = `/**
 * The IDS 1.0 XSD and its imports, inlined.
 *
 * GENERATED by scripts/bundle-ids-schema.mts — do not edit. Re-run it after
 * updating the vendored .xsd files.
 *
 * Inlined rather than fetched from \`public/\`: validation must work with no
 * network at all, and a same-origin fetch is still a request the CSP has to
 * allow and a failure mode the user would see as "validation is broken".
 * These live behind a dynamic import, so they are only downloaded when someone
 * actually validates.
 *
 * The vendored \`ids.xsd\` differs from the published one in exactly one way:
 * its \`xs:import/@schemaLocation\` values point at the sibling files rather than
 * at w3.org URLs. libxml2 resolves those literally, so absolute URLs would mean
 * a network fetch.
 */

`;

const parts = [HEADER];

for (const { file, constant } of FILES) {
  const contents = await readFile(path.join(DIRECTORY, file), "utf8");

  if (contents.includes('schemaLocation="http')) {
    throw new Error(
      `${file} still imports a schema by URL. Point it at the vendored sibling, ` +
        `or validation will try to reach the network and fail under the CSP.`,
    );
  }

  parts.push(`export const ${constant} = ${JSON.stringify(contents)};\n\n`);
}

await writeFile(path.join(DIRECTORY, "generated.ts"), parts.join(""));
console.log(`Wrote ${path.join(DIRECTORY, "generated.ts")}`);
