/* Classifications: two systems on the same model, which is what makes the
   "system and code must match the same reference" rule testable. Wall A is
   Ss_25_10_30 in Uniclass and EF_25_10 in the national system; Wall B is
   Ss_25_10_60 in Uniclass only; the slab is Ss_30_10_30 in Uniclass. */
#200= IFCCLASSIFICATION('NBS','2015','2015-01-01','Uniclass 2015',$,$,$);
#201= IFCCLASSIFICATION('LNEC','1.0','2020-01-01','Sistema Nacional',$,$,$);
#210= IFCCLASSIFICATIONREFERENCE($,'Ss_25_10_30','Framed wall systems',#200,$,$);
#211= IFCCLASSIFICATIONREFERENCE($,'Ss_25_10_60','Solid wall systems',#200,$,$);
#212= IFCCLASSIFICATIONREFERENCE($,'Ss_30_10_30','Floor structure systems',#200,$,$);
#213= IFCCLASSIFICATIONREFERENCE($,'EF_25_10','Paredes',#201,$,$);
