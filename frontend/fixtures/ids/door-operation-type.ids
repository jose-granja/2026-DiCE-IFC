<?xml version="1.0" encoding="UTF-8"?>
<!-- Against fixtures/ifc/door-window-types-ifc4.ifc. IDS 1.0's attribute facet
     reads the occurrence's own attribute, never its type's (unlike the entity
     facet's predefinedType), so D1, which leaves OperationType to its type as
     BLT001 requires, fails "OperationType is required". -->
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>Door operation type</title>
    <author>engenheiro@example.pt</author>
  </info>
  <specifications>
    <specification name="Doors state an operation type" ifcVersion="IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCDOOR</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name><simpleValue>OperationType</simpleValue></name>
        </attribute>
      </requirements>
    </specification>
    <specification name="Windows state a partitioning type" ifcVersion="IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCWINDOW</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name><simpleValue>PartitioningType</simpleValue></name>
        </attribute>
      </requirements>
    </specification>
  </specifications>
</ids>
