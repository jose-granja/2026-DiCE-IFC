<?xml version="1.0" encoding="UTF-8"?>
<!-- Against fixtures/ifc/georeferenced-wall-ifc4.ifc: Wall B carries
     Pset_WallCommon.IsExternal = FALSE, Wall A carries TRUE. Exactly one
     failure — Wall A, the one of the two that has real geometry (Wall B's
     Representation is `$`), which is what this fixture is for: testing that
     a BCF viewpoint snapshot actually frames something. -->
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>Walls are internal</title>
    <description>Every wall must be internal.</description>
    <author>engenheiro@example.pt</author>
    <version>1.0.0</version>
  </info>
  <specifications>
    <specification name="Walls are internal" ifcVersion="IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCWALL</simpleValue></name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" cardinality="required">
          <propertySet><simpleValue>Pset_WallCommon</simpleValue></propertySet>
          <baseName><simpleValue>IsExternal</simpleValue></baseName>
          <value><simpleValue>FALSE</simpleValue></value>
        </property>
      </requirements>
    </specification>
  </specifications>
</ids>
